@page "/productos/nuevo"
@attribute [Authorize(Roles = "Encargada")]
@inject IHttpService Http
@inject NavigationManager Navigation

<PageTitle>Nuevo producto</PageTitle>

<div class="ft-pagina cp-pagina">
    <a class="ft-volver" href="productos"><Icono Nombre="volver" Tamano="18" /> Volver a productos</a>

    <header class="ft-encabezado">
        <div>
            <h1>Nuevo producto</h1>
            <p class="ft-subtitulo">Complete los datos para dar de alta un producto en el catálogo.</p>
        </div>
    </header>

    @if (creado)
    {
        <div class="alert alert-success" role="alert">
            <strong>Producto creado correctamente.</strong>
            <div class="mt-2 d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary btn-sm" @onclick="CrearOtro">Crear otro</button>
                <a class="btn btn-outline-primary btn-sm" href="productos">Ir al listado</a>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <div class="ft-tarjeta ft-tarjeta-cuerpo">
            <ProductoFormulario Modelo="modelo" TextoBoton="Guardar" Enviando="enviando"
                                OnValidSubmit="Guardar" OnCancelar="Cancelar" />
        </div>
    }
</div>

@code {
    private ProductoDTO modelo = NuevoModelo();
    private string? error;
    private bool enviando;
    private bool creado;

    private static ProductoDTO NuevoModelo() => new() { Estado = "Activo" };

    private async Task Guardar()
    {
        if (enviando)
        {
            return;
        }

        enviando = true;
        error = null;

        var resp = await Http.PostAsync<ProductoDTO, int>("api/producto", modelo);
        enviando = false;

        if (resp.Error)
        {
            error = resp.Mensaje;
            return;
        }

        creado = true;
    }

    private void CrearOtro()
    {
        modelo = NuevoModelo();
        error = null;
        creado = false;
    }

    private void Cancelar() => Navigation.NavigateTo("productos");
}

@page "/productos/nuevo"
@attribute [Authorize(Roles = "Encargada")]
@inject IHttpService Http

<PageTitle>Nuevo producto</PageTitle>

<h1 class="h3 mb-3">Nuevo producto</h1>

@if (creado)
{
    <div class="alert alert-success" role="alert">
        Producto creado correctamente.
        <div class="mt-2 d-flex gap-2">
            <button type="button" class="btn btn-primary btn-sm" @onclick="CrearOtro">Crear otro</button>
            <a class="btn btn-outline-primary btn-sm" href="productos">Ir al listado</a>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <EditForm Model="modelo" OnValidSubmit="Guardar" class="col-12 col-lg-8">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-md-4">
                <label for="codigo" class="form-label">Código</label>
                <InputText id="codigo" class="form-control" @bind-Value="modelo.Codigo" />
                <ValidationMessage For="() => modelo.Codigo" />
            </div>
            <div class="col-md-8">
                <label for="nombre" class="form-label">Nombre</label>
                <InputText id="nombre" class="form-control" @bind-Value="modelo.Nombre" />
                <ValidationMessage For="() => modelo.Nombre" />
            </div>
            <div class="col-12">
                <label for="descripcion" class="form-label">Descripción</label>
                <InputTextArea id="descripcion" class="form-control" rows="3" @bind-Value="modelo.Descripcion" />
                <ValidationMessage For="() => modelo.Descripcion" />
            </div>
            <div class="col-md-4">
                <label for="categoria" class="form-label">Categoría</label>
                <InputText id="categoria" class="form-control" @bind-Value="modelo.Categoria" />
                <ValidationMessage For="() => modelo.Categoria" />
            </div>
            <div class="col-md-4">
                <label for="precio" class="form-label">Precio</label>
                <InputNumber id="precio" class="form-control" step="0.01" @bind-Value="modelo.Precio" />
                <ValidationMessage For="() => modelo.Precio" />
            </div>
            <div class="col-md-4">
                <label for="estado" class="form-label">Estado</label>
                <InputSelect id="estado" class="form-select" @bind-Value="modelo.Estado">
                    <option value="Disponible">Disponible</option>
                    <option value="No disponible">No disponible</option>
                </InputSelect>
                <ValidationMessage For="() => modelo.Estado" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@enviando">
                @(enviando ? "Guardando..." : "Guardar")
            </button>
            <a class="btn btn-outline-secondary" href="productos">Cancelar</a>
        </div>
    </EditForm>
}

@code {
    private ProductoDTO modelo = NuevoModelo();
    private string? error;
    private bool enviando;
    private bool creado;

    private static ProductoDTO NuevoModelo() => new() { Estado = "Disponible" };

    private async Task Guardar()
    {
        if (enviando)
        {
            return;
        }

        enviando = true;
        error = null;

        var resp = await Http.PostAsync<ProductoDTO, int>("api/producto", modelo);
        enviando = false;

        if (resp.Error)
        {
            error = resp.Mensaje;
            return;
        }

        creado = true;
    }

    private void CrearOtro()
    {
        modelo = NuevoModelo();
        error = null;
        creado = false;
    }
}

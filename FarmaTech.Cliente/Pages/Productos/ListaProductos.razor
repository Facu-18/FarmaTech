@page "/productos"
@attribute [Authorize]
@using System.Globalization
@inject IHttpService Http
@inject IJSRuntime JS

<PageTitle>Productos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Productos</h1>
    <AuthorizeView Roles="Encargada">
        <a class="btn btn-primary" href="productos/nuevo">Nuevo producto</a>
    </AuthorizeView>
</div>

<form class="row g-2 mb-3" @onsubmit="Buscar" @onsubmit:preventDefault>
    <div class="col">
        <input class="form-control" placeholder="Buscar por nombre o código" @bind="texto" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary" disabled="@cargando">Buscar</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar" disabled="@cargando">Ver todos</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(aviso))
{
    <div class="alert alert-success" role="alert">@aviso</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (cargando)
{
    <p>Cargando...</p>
}
else if (productos.Count == 0 && string.IsNullOrEmpty(error))
{
    <div class="alert alert-info" role="alert">No se encontraron productos.</div>
}
else if (productos.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th>Estado</th>
                    <AuthorizeView Roles="Encargada">
                        <th class="text-end">Acciones</th>
                    </AuthorizeView>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in productos)
                {
                    var producto = p;
                    <tr>
                        <td>@producto.Codigo</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.Categoria</td>
                        <td class="text-end">@producto.Precio.ToString("C", Cultura)</td>
                        <td>
                            <span class="badge @(EstaActivo(producto) ? "text-bg-success" : "text-bg-secondary")">@(EstaActivo(producto) ? "Activo" : "Inactivo")</span>
                        </td>
                        <AuthorizeView Roles="Encargada">
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary @(procesando ? "disabled" : null)"
                                   href="productos/editar/@producto.Id">Editar</a>
                                @if (EstaActivo(producto))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@procesando"
                                            @onclick="() => DarDeBaja(producto)">Dar de baja</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" disabled="@procesando"
                                            @onclick="() => Reactivar(producto)">Reactivar</button>
                                }
                            </td>
                        </AuthorizeView>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly CultureInfo Cultura = new("es-AR");

    [SupplyParameterFromQuery(Name = "mensaje")] public string? Mensaje { get; set; }

    private List<ProductoResponseDTO> productos = new();
    private string texto = string.Empty;
    private string? error;
    private string? aviso;
    private bool cargando;
    private bool procesando;

    // Any estado other than "Inactivo" counts as active (legacy rows)
    private static bool EstaActivo(ProductoResponseDTO p) => p.Estado != "Inactivo";

    protected override async Task OnInitializedAsync()
    {
        aviso = Mensaje;
        await Cargar();
    }

    private Task Buscar() => Cargar();

    private async Task Limpiar()
    {
        texto = string.Empty;
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        error = null;

        var termino = texto.Trim();
        var url = termino.Length == 0
            ? "api/producto"
            : $"api/producto/buscar?texto={Uri.EscapeDataString(termino)}&incluirInactivos=true";

        var resp = await Http.GetAsync<List<ProductoResponseDTO>>(url);
        if (resp.Error)
        {
            productos = new();
            error = resp.Mensaje;
        }
        else
        {
            productos = resp.Respuesta ?? new();
        }

        cargando = false;
    }

    private async Task DarDeBaja(ProductoResponseDTO producto)
    {
        if (procesando)
        {
            return;
        }

        error = null;
        aviso = null;

        if (!await JS.InvokeAsync<bool>("confirm",
                $"¿Desea dar de baja el producto \"{producto.Nombre}\"? Dejará de aparecer en las ventas."))
        {
            return;
        }

        procesando = true;
        var resp = await Http.DeleteAsync<bool>($"api/producto/{producto.Id}");

        if (resp.Error)
        {
            procesando = false;
            error = resp.Mensaje;
            return;
        }

        aviso = $"El producto \"{producto.Nombre}\" se dio de baja.";
        await Cargar();
        procesando = false;
    }

    private async Task Reactivar(ProductoResponseDTO producto)
    {
        if (procesando)
        {
            return;
        }

        error = null;
        aviso = null;
        procesando = true;

        var dto = new ProductoDTO
        {
            Codigo = producto.Codigo,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            Categoria = producto.Categoria,
            Precio = producto.Precio,
            Estado = "Activo"
        };
        var resp = await Http.PutAsync<ProductoDTO, bool>($"api/producto/{producto.Id}", dto);

        if (resp.Error)
        {
            procesando = false;
            error = resp.Mensaje;
            return;
        }

        aviso = $"El producto \"{producto.Nombre}\" se reactivó.";
        await Cargar();
        procesando = false;
    }
}

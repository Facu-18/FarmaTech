@page "/login"
@inject SesionService Sesion
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Iniciar sesión</h1>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <EditForm Model="modelo" OnValidSubmit="IniciarSesion">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="usuario" class="form-label">Usuario</label>
                <InputText id="usuario" class="form-control" @bind-Value="modelo.Usuario" autocomplete="username" />
                <ValidationMessage For="() => modelo.Usuario" />
            </div>

            <div class="mb-3">
                <label for="pin" class="form-label">PIN</label>
                <InputText id="pin" type="password" inputmode="numeric" maxlength="6" class="form-control"
                           @bind-Value="modelo.Pin" autocomplete="current-password" />
                <ValidationMessage For="() => modelo.Pin" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@enviando">
                @(enviando ? "Ingresando..." : "Ingresar")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginDTO modelo = new();
    private string? error;
    private bool enviando;

    private async Task IniciarSesion()
    {
        if (enviando)
        {
            return;
        }

        enviando = true;
        error = null;

        var resp = await Sesion.LoginAsync(modelo);
        enviando = false;

        if (resp.Error)
        {
            error = resp.Mensaje;
            modelo.Pin = string.Empty;
            return;
        }

        Navigation.NavigateTo("");
    }
}

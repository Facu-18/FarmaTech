@inject SesionService Sesion
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FarmaTech</a>
        <button title="Menú de navegación" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="ventas/nueva">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Registrar venta
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="productos" Match="NavLinkMatch.All">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Productos
                    </NavLink>
                </div>
                <AuthorizeView Roles="Encargada" Context="encargada">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="productos/nuevo">
                            <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Nuevo producto
                        </NavLink>
                    </div>
                </AuthorizeView>
                <div class="nav-item px-3 text-white-50 small mt-3">
                    @context.User.Identity?.Name (@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                </div>
                <div class="nav-item px-3">
                    <button type="button" class="nav-link btn btn-link" @onclick="CerrarSesion">Cerrar sesión</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Iniciar sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
        <div class="nav-item px-3">
            <a class="nav-link" href="swagger" target="_blank" rel="noopener noreferrer">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> API (Swagger)
            </a>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task CerrarSesion()
    {
        await Sesion.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
